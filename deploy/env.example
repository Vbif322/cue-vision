# Образец /etc/cue-vision/env для сервера. Смысл переменных — в README.md, «Настройки».
#   sudo install -m 640 -o root -g cue-vision deploy/env.example /etc/cue-vision/env
# и заполнить пустые значения.

# Только localhost: снаружи сервис доступен через nginx.
HTTP_ADDR=127.0.0.1:8080

# Unix-сокет и peer-вход: роль "cue-vision" = пользователь ОС, пароля нет.
DATABASE_URL=postgres://cue-vision@/cuevision?host=/run/postgresql

# Токен детекторов и скриптов (права администратора): openssl rand -hex 32
API_TOKEN=

# Первый администратор, пароль от 8 символов. Задаются только вместе: одна из двух
# переменных без другой — ошибка запуска. После первого запуска стереть ОБЕ строки:
# они нужны, только пока пользователей нет.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Сервис за HTTPS (nginx) — cookie сессии только по HTTPS.
COOKIE_SECURE=true
SESSION_TTL=720h

# Детектор тренера шлёт события сам (POST /api/v1/events), подключаться не к чему.
DETECTORS=

AUTO_TRAINING=true
SKIP_EVENT_TYPES=positions
LOG_LEVEL=info
