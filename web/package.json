{
  "name": "cue-vision-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cue-vision/training",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "oxlint": "^1.93.0"
  }
}
