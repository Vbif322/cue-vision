# Адрес HTTP-сервера.
HTTP_ADDR=:8080

# Строка подключения к PostgreSQL.
DATABASE_URL=postgres://cuevision:cuevision@localhost:5433/cuevision?sslmode=disable

# Токен для детекторов и скриптов: Authorization: Bearer <токен>, права администратора.
# Пусто — вход токеном выключен, в API пускает только сессия по логину и паролю.
API_TOKEN=

# Первый администратор. Заводится при старте, только пока пользователей нет;
# дальше пароль меняют через API, эти значения ни на что не влияют.
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Срок сессии входа; продлевается, пока ею пользуются.
SESSION_TTL=720h

# Ставить cookie сессии только по HTTPS. Включить, если сервис за HTTPS-прокси.
COOKIE_SECURE=false

# Детекторы snooker_CV, запущенные с --ws: поток=адрес через запятую.
# DETECTORS=club1-t1=ws://192.168.1.20:8765,club1-t2=ws://192.168.1.21:8765
DETECTORS=

# Удары вне открытой вручную тренировки собирать в автоматическую.
AUTO_TRAINING=true

# Типы событий, которые не сохраняются. positions идёт на каждый кадр.
SKIP_EVENT_TYPES=positions

# Предел размера тела POST /api/v1/events, байт.
MAX_BODY_BYTES=67108864

# Тишина от детектора дольше этого срока считается обрывом соединения.
DETECTOR_IDLE_TIMEOUT=60s

# debug | info | warn | error
LOG_LEVEL=info
